{
  "name": "@llangtop/pwiki-webpage",
  "version": "1.3.4",
  "files": ["dist", "README.md"],
  "description": "Browser page adapter for the Pwiki HTTP API",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pwiki-webpage": "./dist/server.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc --build --force && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@llangtop/pwiki-api": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
